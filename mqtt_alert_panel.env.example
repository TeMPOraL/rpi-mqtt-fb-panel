MQTT_USER=alertpanel
MQTT_PASS=secretpassword
MQTT_HOST=example-host.local
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=home/lcars_panel/
# Control topic prefix. <hostname> can be used as a placeholder and will be replaced by the actual device hostname.
MQTT_CONTROL_TOPIC_PREFIX=lcars/<hostname>/
# Retained availability topic (MQTT Last Will). The broker sets it to "offline" when
# the panel drops off; the panel publishes "online" only once (re)connected AND all
# subscriptions are confirmed. <hostname> placeholder works here too.
MQTT_AVAILABILITY_TOPIC=lcars/alert-panel/availability
# Retained display mode state topic ("events"/"clock"). Outbound state reporting
# only; the panel never acts on messages published here.
MQTT_MODE_TOPIC=lcars/alert-panel/mode
# Stable MQTT client id, used to correlate broker-side logs with this device.
MQTT_CLIENT_ID=lcars-panel-<hostname>
# Whether to log messages from the control channel to the main display. true or false.
LOG_CONTROL_MESSAGES=true
MAX_MESSAGES_IN_STORE=50
# Path to the LCARS font file, e.g., /usr/share/fonts/truetype/lcars/lcars.ttf
# If not set, the application will fall back to hardcoded paths or default fonts.
LCARS_FONT_PATH="/usr/share/fonts/truetype/dejavu/Swiss-911-Ultra-Compressed-BT-Regular.ttf"

# Path to the touchscreen event device, e.g., /dev/input/event0
# If not set, touch input will be disabled. The application might try to auto-detect.
TOUCH_DEVICE_PATH=
