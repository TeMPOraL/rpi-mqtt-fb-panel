# Environment for the VIRTUAL panel run. Copy to virtual/panel.env and adjust.
# Values here mirror the real device deployment so behavior matches 1:1.
# Precedence: values already set in your shell win over this file.

# --- Panel configuration (same variables the device reads) ---
MQTT_TOPIC_PREFIX=home/alert/
# Explicit control prefix: kills the socket.gethostname() dependency, which
# would otherwise differ between the device ("alert-panel") and your machine.
MQTT_CONTROL_TOPIC_PREFIX=lcars/alert-panel/
MQTT_AVAILABILITY_TOPIC=lcars/alert-panel/availability
MQTT_MODE_TOPIC=lcars/alert-panel/mode
MQTT_CLIENT_ID=lcars-panel-virtual
# Host/port/credentials are accepted and ignored by the fake broker.
MQTT_HOST=virtual-broker
MQTT_PORT=1883
MQTT_USER=alertpanel
MQTT_PASS=unused
STARTING_MODE=clock
LOG_CONTROL_MESSAGES=true
MAX_MESSAGES_IN_STORE=50
DISPLAY_ROTATE=0
# REQUIRED for touch: the panel's evdev auto-detect cannot match the faithful
# python-evdev capabilities shape (see virtual/PLAN.md observations), so the
# device path must be explicit. The fake touch device registers at this path.
TOUCH_DEVICE_PATH=/dev/input/event0
# LCARS_FONT_PATH intentionally unset: the runner resolves it (Swiss911 if
# present in virtual/fonts/, else vendored DejaVuSans with a warning).

# --- Harness-only configuration ---
# Virtual framebuffer geometry; must match the device for fidelity.
# 720x480 confirmed by the repo's device screenshots. bpp=32: the device must
# be running framebuffer_utils' 32bpp/BGRA branch, because the 16bpp branch
# ("BGR;16" packing from RGB) does not work on ANY known Pillow version —
# see virtual/PLAN.md observations. 32bpp means colors are NOT quantized.
VIRTUAL_FB_WIDTH=720
VIRTUAL_FB_HEIGHT=480
VIRTUAL_FB_BPP=32
# Raw coordinate range of the fake touch device.
VIRTUAL_TOUCH_ABS_MAX=4095
# HTTP viewer binding.
VIRTUAL_HTTP_PORT=8724
VIRTUAL_HTTP_BIND=127.0.0.1
